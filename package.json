{
  "name": "wordjumblebot",
  "version": "1.3.0",
  "private": true,
  "description": "WordJumbleBot for Discord",
  "keywords": [
    "jumble",
    "word",
    "bot",
    "discord"
  ],
  "homepage": "https://github.com/chump29/wordjumblebot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/wordjumblebot.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "scripts": {
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:*,lcov-total\"",
    "dev": "bun run --bun --watch index.ts",
    "env": "bun run --bun utils/env.ts",
    "env:test": "NODE_ENV=test bun run --bun utils/env.ts",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:env && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:env": "bun run --bun dotenv-linter check .",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun .husky/prepare.min.mjs",
    "prod": "bun run --bun index.ts",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:e18e",
    "scan:audit": "bun audit",
    "scan:cve": "bunx --bun cve-lite-cli --check-overrides --check-network --check-maintenance",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "sql": "drizzle-kit generate",
    "test": "bun test --isolate --dots --bail",
    "test:coverage": "bun test --isolate --dots --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:coverage:full": "bun test --isolate --coverage --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --bail",
    "test:full": "bun test --isolate --bail",
    "updates": "bunx --bun npm-check-updates --dep overrides,prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*.{json,ts}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings",
    ".env*": "bun run --bun dotenv-linter check"
  },
  "overrides": {
    "@biomejs/biome": "2.5.15",
    "@discordjs/collection": "2.1.1",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "chalk": "6.0.1",
    "cspell": "10.3.6",
    "globals": "17.13.0",
    "ini": "7.0.0"
  },
  "dependencies": {
    "@jarrodek/pluralize": "^1.0.2",
    "@postfmly/checkrate": "^2.0.4",
    "@postfmly/logger": "^1.1.9",
    "@postfmly/logoserver": "^1.3.14",
    "@wordlist/english-eff": "^1.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "1.0.0-rc.4",
    "envalid": "^8.2.0",
    "magic-regexp": "^0.11.2",
    "ts-pattern": "^5.9.1",
    "unique-random": "^4.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@postfmly/config": "^1.6.4",
    "drizzle-kit": "1.0.0-rc.4",
    "expect-type": "^1.4.0",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "^1.4.3"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "@jarrodek/pluralize@1.0.2": "patches/@jarrodek%2Fpluralize@1.0.2.patch"
  }
}
