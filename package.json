{
  "name": "wordjumblebot",
  "version": "1.2.0",
  "private": true,
  "description": "WordJumbleBot for Discord",
  "keywords": [
    "jumble",
    "word",
    "bot",
    "discord"
  ],
  "homepage": "https://github.com/chump29/wordjumblebot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/wordjumblebot.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "clean": "rimraf node_modules bun.lock",
    "clean:db": "rimraf db/wordjumblebot.db*",
    "dev": "bun --watch run index.ts",
    "preinstall": "bunx only-allow bun",
    "postinstall": "config-init",
    "lint": "bun run lint:biome && bun run lint:env",
    "lint:biome": "biome check --write --verbose",
    "lint:ci": "biome ci --verbose --reporter=default --reporter=github",
    "lint:env": "dotenv-linter check .",
    "prepare": "husky",
    "prod": "bun run index.ts",
    "test": "bun test --coverage --isolate"
  },
  "lint-staged": {
    ".env*": "dotenv-linter check",
    "*.{json,ts}": "biome ci --no-errors-on-unmatched"
  },
  "dependencies": {
    "@postfmly/logger": "^1.0.1",
    "@postfmly/logoserver": "^1.0.2",
    "@wordlist/english-eff": "^1.0.1",
    "@wordlist/random": "^5.0.0",
    "discord.js": "^14.26.4",
    "discord.js-rate-limiter": "^1.3.2",
    "drizzle-orm": "1.0.0-rc.2",
    "ms": "^2.1.3",
    "pluralize": "^8.0.0",
    "pretty-ms": "^9.3.0"
  },
  "devDependencies": {
    "@nano-faker/number": "^1.0.1",
    "@nano-faker/patterns": "^1.0.1",
    "@nano-faker/person": "^1.0.1",
    "@postfmly/config": "^1.2.14",
    "@types/ms": "^2.1.0",
    "@types/pluralize": "^0.0.33",
    "drizzle-seed": "1.0.0-rc.2",
    "husky": "^9.1.7",
    "jest-mock": "^30.3.0",
    "lint-staged": "^17.0.2",
    "rimraf": "^6.1.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "~1.3.13"
  },
  "engineStrict": true,
  "patchedDependencies": {
    "pluralize@8.0.0": "patches/pluralize@8.0.0.patch"
  }
}
